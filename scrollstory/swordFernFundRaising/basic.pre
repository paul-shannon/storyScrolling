<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <title>ScrollStory: Basic</title>
    <link rel="stylesheet" href="css/base-examples.css">
</head>

<body>
    <div id="container">
        <div class="stories">
          <div class="story" style="height: fit-content; padding: 0px;
                                    padding-bottom: 10px;">
            <center>
        <h2 style="font-family: georgia">Sword Fern Die-off, Seward Park</h2>
          </div>
m4_include(sew101-sep22-feb25.html)
m4_include(deadCrown.html)
m4_include(part2.html)
            <div class="story"><span>3</span></div>
            <div class="story"><span>4</span></div>
            <div class="story"><span>5</span></div>
            <div class="story"><span>6</span></div>
            <div class="story"><span>7</span></div>
            <div class="story"><span>8</span></div>
            <div class="story"><span>9</span></div>
            <div class="story"><span>10</span></div>
            <div class="story"><span>11</span></div>
            <div class="story"><span>12</span></div>
            <div class="story"><span>13</span></div>
        </div>
    </div>
    <script src="https://pshannon.net/story/js/jquery.min.js"></script>
    <script src="https://pshannon.net/story/js/jquery.scrollstory.js"></script>
    <script>
    (function($) {
        // make existing elements 60% of window height
        //$('.story').css({'height': $(window).height() * 0.3});

        $('.stories').scrollStory(
            {debug: true,
             triggerOffset: 30,
             autoActivateFirstItem: true
            })
            })(jQuery);
    </script>
</body>
</html>
